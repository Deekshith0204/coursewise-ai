# ========================================================
# CourseWise AI - Environment Configuration Example
# ========================================================

# Copy this file to coursewise-ai/backend/.env and populate your values:

# AI Provider Configuration
# Set your API Key below (e.g. Gemini API key from Google AI Studio, or OpenAI API key)
AI_API_KEY=
AI_MODEL=gemini-1.5-flash
AI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai
AI_PROVIDER=openai

# Database Configuration (defaults to local SQLite)
DATABASE_URL=sqlite:///../data/coursewise.db

# CORS Allowed Origins
ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Frontend Environment Variable (optional override in frontend/.env.local)
NEXT_PUBLIC_API_URL=http://localhost:8000/api
