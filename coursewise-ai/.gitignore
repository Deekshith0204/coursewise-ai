# ========================================================
# CourseWise AI - .gitignore
# ========================================================

# Environment Variables & Secrets
.env
.env.*
.env.local
.env.development.local
.env.test.local
.env.production.local
!*.env.example
!**/.env.example

# Node / Next.js
node_modules/
**/node_modules/
.next/
**/.next/
out/
dist/
build/
*.tsbuildinfo
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# Python & Virtual Environments
__pycache__/
**/__pycache__/
*.py[cod]
*$py.class
*.so
.Python
env/
venv/
.venv/

# Testing & Cache
.pytest_cache/
**/.pytest_cache/
.coverage
htmlcov/

# Database & Runtime State
*.db
*.db-journal
*.sqlite
*.sqlite3
**/coursewise.db
coursewise.db

# User Uploaded Documents
data/uploads/*
!data/uploads/.gitkeep
**/data/uploads/*
!**/data/uploads/.gitkeep

# IDEs & OS
.DS_Store
Thumbs.db
.vscode/
.idea/
*.swp
*.swo
*~
*.log
