# ========================================================
# CourseWise AI - Environment Configuration
# ========================================================

# AI Provider Configuration
# Supported providers: Google Gemini, OpenAI, Groq, Ollama, OpenRouter
AI_API_KEY=
AI_MODEL=gemini-1.5-flash
AI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai
AI_PROVIDER=openai

# Database Configuration (defaults to local SQLite)
# SQLite path: data/coursewise.db
DATABASE_URL=sqlite:///../data/coursewise.db

# CORS Configuration for Frontend
ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Next.js Frontend Environment Variable (Frontend/.env.local)
# NEXT_PUBLIC_API_URL=http://localhost:8000/api
